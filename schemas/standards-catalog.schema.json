{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-ipo.org/schemas/standards-catalog.schema.json",
  "title": "open-ipo Standards Catalog",
  "description": "Machine-readable index of canonical open-ipo standards, schemas, governance artifacts, implementations, and examples.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalog_version",
    "project",
    "status_boundary",
    "artifacts"
  ],
  "properties": {
    "catalog_version": {
      "const": "open-ipo-standards-catalog.v0.1"
    },
    "project": {
      "const": "open-ipo"
    },
    "status_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "live_exchange",
        "adopted_rulebook",
        "legal_authority",
        "note"
      ],
      "properties": {
        "live_exchange": { "const": false },
        "adopted_rulebook": { "const": false },
        "legal_authority": { "const": false },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "kind",
        "path",
        "status",
        "normative"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "standard",
            "schema",
            "policy",
            "governance",
            "guide",
            "example",
            "implementation",
            "workflow"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\.\\./).+$"
        },
        "status": {
          "enum": [
            "draft",
            "candidate",
            "stable",
            "deprecated",
            "retired"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^v?[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
        },
        "wire_version": {
          "type": "string",
          "minLength": 1
        },
        "normative": {
          "type": "boolean"
        },
        "canonical_for": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          }
        },
        "conforms_to": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
