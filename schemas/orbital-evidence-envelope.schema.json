{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-ipo.org/schemas/orbital-evidence-envelope.schema.json",
  "title": "Orbital Evidence Envelope",
  "description": "Project proposal for a machine-readable envelope binding a material issuer claim to subject identity, observation time, provenance, uncertainty, assertion, optional attestations, freshness policy, disclosure limits, and supersession history. Schema validity does not establish factual truth or legal sufficiency.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "envelope_id",
    "revision",
    "issued_at",
    "issuer",
    "subject",
    "claim",
    "observation",
    "evidence_items",
    "assertion",
    "attestations",
    "freshness_policy",
    "completeness",
    "disclosure",
    "supersession",
    "disclaimer"
  ],
  "properties": {
    "schema_version": {
      "const": "orbital-evidence-envelope.v0.1"
    },
    "envelope_id": {
      "$ref": "#/$defs/stableId"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "issuer": {
      "$ref": "#/$defs/issuer"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "claim": {
      "$ref": "#/$defs/claim"
    },
    "observation": {
      "$ref": "#/$defs/observation"
    },
    "evidence_items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/evidenceItem"
      }
    },
    "assertion": {
      "$ref": "#/$defs/assertion"
    },
    "attestations": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/attestation"
      }
    },
    "freshness_policy": {
      "$ref": "#/$defs/freshnessPolicy"
    },
    "completeness": {
      "$ref": "#/$defs/completeness"
    },
    "communications_context": {
      "$ref": "#/$defs/communicationsContext"
    },
    "disclosure": {
      "$ref": "#/$defs/disclosure"
    },
    "supersession": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/supersession"
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "disclaimer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#@+-]*$"
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "longText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "uriOrReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_identifier",
        "name"
      ],
      "properties": {
        "canonical_identifier": {
          "$ref": "#/$defs/stableId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "jurisdiction": {
          "type": ["string", "null"],
          "maxLength": 256
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "canonical_identifier",
        "name",
        "related_subjects"
      ],
      "properties": {
        "type": {
          "enum": [
            "ISSUER",
            "ASSET",
            "AGENT",
            "SERVICE_DELIVERY",
            "RESOURCE_BODY_OR_INVENTORY",
            "INCIDENT",
            "CONTRACT_OR_RIGHT",
            "CONTINUITY_TEST",
            "OTHER"
          ]
        },
        "canonical_identifier": {
          "$ref": "#/$defs/stableId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "related_subjects": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/relatedSubject"
          }
        }
      }
    },
    "relatedSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationship",
        "type",
        "canonical_identifier"
      ],
      "properties": {
        "relationship": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "enum": [
            "ISSUER",
            "ASSET",
            "AGENT",
            "SERVICE_DELIVERY",
            "RESOURCE_BODY_OR_INVENTORY",
            "INCIDENT",
            "CONTRACT_OR_RIGHT",
            "CONTINUITY_TEST",
            "OTHER"
          ]
        },
        "canonical_identifier": {
          "$ref": "#/$defs/stableId"
        },
        "name": {
          "type": ["string", "null"],
          "maxLength": 256
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "claim_type",
        "statement",
        "scope",
        "materiality"
      ],
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/stableId"
        },
        "claim_type": {
          "enum": [
            "ASSET_OPERATIONAL",
            "ASSET_LOCATION_OR_STATE",
            "SERVICE_DELIVERED",
            "PAYLOAD_OUTPUT_PRODUCED",
            "RESOURCE_MEASUREMENT",
            "RESOURCE_INVENTORY",
            "AGENT_ACTION_EXECUTED",
            "AGENT_AUTHORITY_VALID",
            "RIGHT_OR_CONTROL_EXISTS",
            "INCIDENT_OCCURRED",
            "ASSET_IMPAIRED",
            "CONTINUITY_TEST_COMPLETED",
            "FINANCIAL_RECONCILIATION",
            "OTHER"
          ]
        },
        "statement": {
          "$ref": "#/$defs/longText"
        },
        "scope": {
          "$ref": "#/$defs/shortText"
        },
        "materiality": {
          "enum": [
            "MATERIAL",
            "SUPPORTING",
            "CONTEXTUAL"
          ]
        },
        "value": {
          "type": [
            "string",
            "number",
            "integer",
            "boolean",
            "null"
          ]
        },
        "unit": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "valid_from": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "valid_until": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_at",
        "environment",
        "method",
        "time_basis",
        "uncertainty"
      ],
      "properties": {
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_recorded_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "received_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "environment": {
          "enum": [
            "LIVE_OPERATION",
            "SIMULATION",
            "TEST",
            "DERIVED_ANALYSIS",
            "UNKNOWN"
          ]
        },
        "method": {
          "$ref": "#/$defs/longText"
        },
        "location_context": {
          "type": ["string", "null"],
          "maxLength": 1000
        },
        "time_basis": {
          "$ref": "#/$defs/timeBasis"
        },
        "uncertainty": {
          "$ref": "#/$defs/uncertainty"
        }
      }
    },
    "timeBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_identifier",
        "quality"
      ],
      "properties": {
        "source_identifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "quality": {
          "enum": [
            "SYNCHRONIZED",
            "BOUNDED_UNCERTAINTY",
            "LOCAL_ONLY",
            "UNKNOWN"
          ]
        },
        "uncertainty_seconds": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "notes": {
          "type": ["string", "null"],
          "maxLength": 1000
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary"
      ],
      "properties": {
        "status": {
          "enum": [
            "QUANTIFIED",
            "QUALITATIVE",
            "NOT_APPLICABLE",
            "UNKNOWN"
          ]
        },
        "summary": {
          "$ref": "#/$defs/shortText"
        },
        "absolute_error": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "relative_error_percent": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "confidence_percent": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "lower_bound": {
          "type": ["number", "null"]
        },
        "upper_bound": {
          "type": ["number", "null"]
        },
        "calibration_reference": {
          "type": ["string", "null"],
          "maxLength": 2048
        }
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "evidence_type",
        "source",
        "acquisition_method",
        "content",
        "transformations",
        "disclosure_state",
        "limitations"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/stableId"
        },
        "evidence_type": {
          "enum": [
            "TELEMETRY_SUMMARY",
            "MISSION_LOG",
            "SIGNED_EVENT_LOG",
            "THIRD_PARTY_OBSERVATION",
            "CUSTOMER_RECORD",
            "BILLING_OR_ACCOUNTING_RECORD",
            "CONTRACT_OR_RIGHT_RECORD",
            "CHAIN_OF_CUSTODY_RECORD",
            "MEASUREMENT_REPORT",
            "INCIDENT_RECORD",
            "CONTROL_AUTHORITY_RECORD",
            "SOFTWARE_OR_POLICY_RECORD",
            "TEST_RESULT",
            "IMAGE_OR_SENSOR_PRODUCT",
            "OTHER"
          ]
        },
        "source": {
          "$ref": "#/$defs/evidenceSource"
        },
        "observed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "acquisition_method": {
          "$ref": "#/$defs/shortText"
        },
        "content": {
          "$ref": "#/$defs/evidenceContent"
        },
        "transformations": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/transformation"
          }
        },
        "disclosure_state": {
          "enum": [
            "PUBLIC",
            "PUBLIC_REDACTED",
            "REFERENCE_ONLY",
            "WITHHELD_SECURITY_SENSITIVE",
            "WITHHELD_LEGAL_OR_CONTRACTUAL"
          ]
        },
        "limitations": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "evidenceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_class",
        "canonical_identifier",
        "operator_identifier",
        "relationship_to_issuer"
      ],
      "properties": {
        "source_class": {
          "enum": [
            "ISSUER_SYSTEM",
            "ISSUER_AGENT",
            "ASSET_ONBOARD_SYSTEM",
            "GROUND_SYSTEM",
            "CUSTOMER_SYSTEM",
            "COUNTERPARTY_SYSTEM",
            "INDEPENDENT_SENSOR",
            "PUBLIC_AUTHORITY",
            "AUDITOR_OR_ASSURANCE_PROVIDER",
            "OTHER"
          ]
        },
        "canonical_identifier": {
          "$ref": "#/$defs/stableId"
        },
        "operator_identifier": {
          "type": ["string", "null"],
          "maxLength": 256
        },
        "relationship_to_issuer": {
          "enum": [
            "ISSUER_CONTROLLED",
            "AFFILIATE",
            "CUSTOMER",
            "SUPPLIER",
            "COUNTERPARTY",
            "INDEPENDENT_THIRD_PARTY",
            "PUBLIC_AUTHORITY",
            "UNKNOWN",
            "OTHER"
          ]
        },
        "notes": {
          "type": ["string", "null"],
          "maxLength": 1000
        }
      }
    },
    "evidenceContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "digest",
        "media_type",
        "digest_scope"
      ],
      "properties": {
        "uri": {
          "type": ["string", "null"],
          "maxLength": 2048
        },
        "digest": {
          "anyOf": [
            { "$ref": "#/$defs/digest" },
            { "type": "null" }
          ]
        },
        "media_type": {
          "type": ["string", "null"],
          "maxLength": 256
        },
        "size_bytes": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "digest_scope": {
          "enum": [
            "ORIGINAL_SOURCE",
            "TRANSFORMED_ARTIFACT",
            "REDACTED_PUBLIC_ARTIFACT",
            "CANONICAL_RECORD",
            "NOT_APPLICABLE"
          ]
        }
      },
      "anyOf": [
        {
          "properties": {
            "uri": { "type": "string", "minLength": 1 }
          },
          "required": ["uri"]
        },
        {
          "properties": {
            "digest": { "$ref": "#/$defs/digest" }
          },
          "required": ["digest"]
        }
      ]
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._+-]+$"
        },
        "value": {
          "type": "string",
          "minLength": 16,
          "maxLength": 512,
          "pattern": "^[A-Fa-f0-9_-]+$"
        }
      }
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "method",
        "version"
      ],
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 1
        },
        "method": {
          "$ref": "#/$defs/shortText"
        },
        "version": {
          "type": ["string", "null"],
          "maxLength": 256
        },
        "input_reference": {
          "type": ["string", "null"],
          "maxLength": 2048
        },
        "output_digest": {
          "anyOf": [
            { "$ref": "#/$defs/digest" },
            { "type": "null" }
          ]
        }
      }
    },
    "actorIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_identifier",
        "name",
        "actor_type"
      ],
      "properties": {
        "canonical_identifier": {
          "$ref": "#/$defs/stableId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "actor_type": {
          "enum": [
            "LEGAL_ENTITY",
            "HUMAN",
            "AGENT",
            "PUBLIC_AUTHORITY",
            "ASSURANCE_PROVIDER",
            "OTHER"
          ]
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertion_type",
        "assertor",
        "relationship_to_issuer",
        "issued_at",
        "accountable_principal",
        "signature"
      ],
      "properties": {
        "assertion_type": {
          "enum": [
            "ISSUER_ASSERTION",
            "CONTROLLED_AGENT_ASSERTION",
            "COUNTERPARTY_ASSERTION",
            "OTHER"
          ]
        },
        "assertor": {
          "$ref": "#/$defs/actorIdentity"
        },
        "relationship_to_issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "accountable_principal": {
          "anyOf": [
            { "$ref": "#/$defs/actorIdentity" },
            { "type": "null" }
          ]
        },
        "signature": {
          "anyOf": [
            { "$ref": "#/$defs/signature" },
            { "type": "null" }
          ]
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "signature_value",
        "canonicalization",
        "credential_status_reference"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "signature_value": {
          "type": "string",
          "minLength": 16,
          "maxLength": 4096
        },
        "canonicalization": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "credential_status_reference": {
          "type": ["string", "null"],
          "maxLength": 2048
        }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attestation_id",
        "attestor",
        "relationship",
        "scope",
        "conclusion",
        "issued_at",
        "limitations",
        "signature"
      ],
      "properties": {
        "attestation_id": {
          "$ref": "#/$defs/stableId"
        },
        "attestor": {
          "$ref": "#/$defs/actorIdentity"
        },
        "relationship": {
          "$ref": "#/$defs/attestorRelationship"
        },
        "scope": {
          "$ref": "#/$defs/attestationScope"
        },
        "conclusion": {
          "enum": [
            "SUPPORTS",
            "CONTRADICTS",
            "INCONCLUSIVE",
            "NOT_REVIEWED"
          ]
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "limitations": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "signature": {
          "anyOf": [
            { "$ref": "#/$defs/signature" },
            { "type": "null" }
          ]
        }
      }
    },
    "attestorRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "independence_claimed",
        "description"
      ],
      "properties": {
        "category": {
          "enum": [
            "UNAFFILIATED_THIRD_PARTY",
            "AUDITOR_OR_ASSURANCE_PROVIDER",
            "CUSTOMER",
            "SUPPLIER",
            "INSURER",
            "LENDER",
            "SHAREHOLDER",
            "AFFILIATE",
            "OPERATOR",
            "PUBLIC_AUTHORITY",
            "OTHER",
            "UNKNOWN"
          ]
        },
        "independence_claimed": {
          "type": "boolean"
        },
        "description": {
          "$ref": "#/$defs/shortText"
        }
      }
    },
    "attestationScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_item_ids",
        "reviewed_dimensions",
        "summary"
      ],
      "properties": {
        "evidence_item_ids": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "reviewed_dimensions": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 20,
          "items": {
            "enum": [
              "OBSERVATION_OCCURRED",
              "SUBJECT_IDENTITY",
              "MEASUREMENT_METHOD",
              "RIGHT_OR_CONTROL",
              "CONTENT_DIGEST",
              "CONTROL_AUTHORITY",
              "FINANCIAL_RECONCILIATION",
              "CHAIN_OF_CUSTODY",
              "CLAIM_AS_A_WHOLE",
              "OTHER"
            ]
          }
        },
        "summary": {
          "$ref": "#/$defs/longText"
        }
      }
    },
    "freshnessPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "current_for_seconds",
        "stale_after_seconds",
        "expires_at",
        "rationale"
      ],
      "properties": {
        "basis": {
          "enum": [
            "CLAIM_OBSERVATION_TIME",
            "CLAIM_VALID_FROM",
            "OTHER"
          ]
        },
        "current_for_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 315576000
        },
        "stale_after_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 315576000
        },
        "expires_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "rationale": {
          "$ref": "#/$defs/shortText"
        }
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_method",
        "coverage_start",
        "coverage_end",
        "expected_observation_count",
        "included_observation_count",
        "missing_observation_count",
        "known_exclusions",
        "known_contradictions",
        "summary"
      ],
      "properties": {
        "selection_method": {
          "enum": [
            "COMPLETE_POPULATION",
            "SYSTEMATIC_SAMPLE",
            "RANDOM_SAMPLE",
            "JUDGMENTAL_SAMPLE",
            "SINGLE_EVENT",
            "OTHER",
            "UNKNOWN"
          ]
        },
        "coverage_start": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "coverage_end": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "expected_observation_count": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "included_observation_count": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "missing_observation_count": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "known_exclusions": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "known_contradictions": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "summary": {
          "$ref": "#/$defs/longText"
        }
      }
    },
    "communicationsContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connectivity_state",
        "expected_delay_seconds",
        "observed_delay_seconds",
        "notes"
      ],
      "properties": {
        "connectivity_state": {
          "enum": [
            "NORMAL",
            "DEGRADED",
            "PARTITIONED",
            "RECOVERED",
            "UNKNOWN"
          ]
        },
        "expected_delay_seconds": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "observed_delay_seconds": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "notes": {
          "type": ["string", "null"],
          "maxLength": 1000
        }
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "raw_source_public",
        "security_sensitive",
        "redactions",
        "limitations"
      ],
      "properties": {
        "state": {
          "enum": [
            "PUBLIC",
            "PUBLIC_REDACTED",
            "REFERENCE_ONLY",
            "WITHHELD_SECURITY_SENSITIVE",
            "WITHHELD_LEGAL_OR_CONTRACTUAL"
          ]
        },
        "raw_source_public": {
          "type": "boolean"
        },
        "security_sensitive": {
          "type": "boolean"
        },
        "redactions": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/redaction"
          }
        },
        "limitations": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "reason",
        "digest_retained",
        "independent_reviewed",
        "impact_on_claim"
      ],
      "properties": {
        "category": {
          "enum": [
            "SECURITY_SENSITIVE",
            "PROPRIETARY",
            "PERSONAL_DATA",
            "LEGAL_OR_CONTRACTUAL",
            "CONTROLLED_TECHNICAL_DATA",
            "OTHER"
          ]
        },
        "reason": {
          "$ref": "#/$defs/shortText"
        },
        "digest_retained": {
          "type": "boolean"
        },
        "independent_reviewed": {
          "type": "boolean"
        },
        "impact_on_claim": {
          "$ref": "#/$defs/shortText"
        }
      }
    },
    "supersession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationship",
        "prior_envelope_id",
        "reason",
        "effective_at"
      ],
      "properties": {
        "relationship": {
          "enum": [
            "SUPERSEDE",
            "CORRECT",
            "REVOKE",
            "RESTATE"
          ]
        },
        "prior_envelope_id": {
          "$ref": "#/$defs/stableId"
        },
        "reason": {
          "$ref": "#/$defs/longText"
        },
        "effective_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
